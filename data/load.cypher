// NODES 2026 graph loader. Run against an empty Aura instance:
//   neo4j-cli query --credential nodes-2026 --rw < data/load.cypher
// Re-runnable: everything is MERGE / IF NOT EXISTS.
// The CSVs are generated by build/ (neo4j-graphrag); don't edit them by hand.
// Lists are ';'-separated. embedding = 1536 floats (OpenAI text-embedding-3-small).

CREATE CONSTRAINT session_id IF NOT EXISTS FOR (s:Session) REQUIRE s.id IS UNIQUE;
CREATE CONSTRAINT slot_id IF NOT EXISTS FOR (s:Slot) REQUIRE s.id IS UNIQUE;
CREATE CONSTRAINT speaker_id IF NOT EXISTS FOR (p:Speaker) REQUIRE p.id IS UNIQUE;
CREATE CONSTRAINT session_chunk_id IF NOT EXISTS FOR (c:SessionChunk) REQUIRE c.id IS UNIQUE;
CREATE CONSTRAINT track_name IF NOT EXISTS FOR (t:Track) REQUIRE t.name IS UNIQUE;
CREATE CONSTRAINT topic_name IF NOT EXISTS FOR (t:Topic) REQUIRE t.name IS UNIQUE;
CREATE CONSTRAINT use_case_name IF NOT EXISTS FOR (u:UseCase) REQUIRE u.name IS UNIQUE;
CREATE CONSTRAINT technology_id IF NOT EXISTS FOR (e:Technology) REQUIRE e.id IS UNIQUE;
CREATE CONSTRAINT concept_id IF NOT EXISTS FOR (e:Concept) REQUIRE e.id IS UNIQUE;
CREATE CONSTRAINT organization_id IF NOT EXISTS FOR (e:Organization) REQUIRE e.id IS UNIQUE;
CREATE CONSTRAINT domain_id IF NOT EXISTS FOR (e:Domain) REQUIRE e.id IS UNIQUE;

LOAD CSV WITH HEADERS FROM 'https://raw.githubusercontent.com/jpadams/nodes-2026-agent/main/data/sessions.csv' AS row
MERGE (s:Session {id: row.id})
SET s.title = row.title,
    s.description = row.description,
    s.levels = split(row.levels, ';'),
    s.formats = split(row.formats, ';')
FOREACH (name IN CASE WHEN row.track IS NULL THEN [] ELSE [row.track] END |
  MERGE (t:Track {name: name}) MERGE (s)-[:IN_TRACK]->(t))
FOREACH (name IN coalesce(split(row.topics, ';'), []) |
  MERGE (t:Topic {name: name}) MERGE (s)-[:HAS_TOPIC]->(t))
FOREACH (name IN coalesce(split(row.useCases, ';'), []) |
  MERGE (u:UseCase {name: name}) MERGE (s)-[:HAS_USE_CASE]->(u));

LOAD CSV WITH HEADERS FROM 'https://raw.githubusercontent.com/jpadams/nodes-2026-agent/main/data/slots.csv' AS row
MATCH (s:Session {id: row.sessionId})
WITH s, row, datetime(row.startTime) AS start
MERGE (sl:Slot {id: row.id})
SET sl.startTime = start,
    sl.durationMinutes = toInteger(row.durationMinutes),
    sl.endTime = start + duration({minutes: toInteger(row.durationMinutes)}),
    // What the agent shows people, e.g. "Wed 11 Nov, 18:00 UTC".
    sl.displayTime = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'][start.dayOfWeek - 1] + ' ' + toString(start.day) + ' '
      + ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'][start.month - 1] + ', '
      + right('0' + toString(start.hour), 2) + ':' + right('0' + toString(start.minute), 2) + ' UTC'
MERGE (s)-[:HAS_SLOT]->(sl);

LOAD CSV WITH HEADERS FROM 'https://raw.githubusercontent.com/jpadams/nodes-2026-agent/main/data/speakers.csv' AS row
MERGE (p:Speaker {id: row.id})
SET p.name = row.name;

LOAD CSV WITH HEADERS FROM 'https://raw.githubusercontent.com/jpadams/nodes-2026-agent/main/data/presents.csv' AS row
MATCH (p:Speaker {id: row.speakerId}), (s:Session {id: row.sessionId})
MERGE (p)-[:PRESENTS]->(s);

// One embedded chunk per session (title, speakers, description). SessionChunk keeps
// these apart from other :Chunk nodes already in the database (e.g. from graphrag tutorials).
LOAD CSV WITH HEADERS FROM 'https://raw.githubusercontent.com/jpadams/nodes-2026-agent/main/data/chunks.csv' AS row
MATCH (s:Session {id: row.sessionId})
MERGE (c:Chunk:SessionChunk {id: row.id})
SET c.text = row.text, c.index = 0
MERGE (c)-[:FROM_DOCUMENT]->(s)
WITH c, row WHERE row.embedding IS NOT NULL
CALL db.create.setNodeVectorProperty(c, 'embedding', [x IN split(row.embedding, ';') | toFloat(x)]);

// Entities extracted from the chunks by the LLM: Technology, Concept, Organization, Domain.
LOAD CSV WITH HEADERS FROM 'https://raw.githubusercontent.com/jpadams/nodes-2026-agent/main/data/entities.csv' AS row
MERGE (e:$(row.label) {id: row.id})
SET e.name = row.name;

LOAD CSV WITH HEADERS FROM 'https://raw.githubusercontent.com/jpadams/nodes-2026-agent/main/data/mentions.csv' AS row
MATCH (s:Session {id: row.sessionId})<-[:FROM_DOCUMENT]-(c:SessionChunk)
MATCH (e:$(row.entityLabel) {id: row.entityId})
MERGE (s)-[:MENTIONS]->(e)
MERGE (e)-[:FROM_CHUNK]->(c);

LOAD CSV WITH HEADERS FROM 'https://raw.githubusercontent.com/jpadams/nodes-2026-agent/main/data/entity_relationships.csv' AS row
MATCH (a:$(row.startLabel) {id: row.startId}), (b:$(row.endLabel) {id: row.endId})
MERGE (a)-[:$(row.type)]->(b);

// Accent-insensitive speaker lookup: "Eifrém" finds "Eifrem", "Golab" finds "Gołąb".
CREATE FULLTEXT INDEX speaker_names IF NOT EXISTS
FOR (p:Speaker) ON EACH [p.name]
OPTIONS {indexConfig: {`fulltext.analyzer`: 'standard-folding'}};

CREATE VECTOR INDEX session_chunk_embeddings IF NOT EXISTS
FOR (c:SessionChunk) ON c.embedding
OPTIONS {indexConfig: {`vector.dimensions`: 1536, `vector.similarity_function`: 'cosine'}};

MATCH (s:Session) WITH count(s) AS sessions
MATCH (p:Speaker) WITH sessions, count(p) AS speakers
MATCH (c:SessionChunk) WHERE c.embedding IS NOT NULL WITH sessions, speakers, count(c) AS embeddedChunks
MATCH ()-[m:MENTIONS]->() WITH sessions, speakers, embeddedChunks, count(m) AS mentions
RETURN sessions, speakers, embeddedChunks, mentions;
